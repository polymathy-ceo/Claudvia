# Copy to .env.local for development. Never commit real secrets.
# Without CLAUDVIA_DATABASE_URL, local development uses a JSON file under ./data.
# Production MUST set CLAUDVIA_DATABASE_URL to a persistent PostgreSQL database.
CLAUDVIA_DATABASE_URL=
CLAUDVIA_DATABASE_SSL=false

# Use a random secret with at least 32 characters in production.
# Generate locally with: openssl rand -hex 32
CLAUDVIA_TOKEN_SECRET=
CLAUDVIA_RATE_LIMIT_SECRET=

# SMTP delivery is required for newsletter confirmation and contact messages.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Public site base URL used inside emails. Keep http://localhost:3000 for local work.
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Destination inbox for business/contact inquiries.
CONTACT_EMAIL=
# Optional visible contact address on the website; leave blank until chosen and usable.
NEXT_PUBLIC_CONTACT_EMAIL=
